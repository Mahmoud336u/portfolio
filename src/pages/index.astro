---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile, projects, expertise, experience, resumes, contact, certifications } from '../data/portfolio';
const [meridian, multiAgent] = projects;
---
<Layout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content"><p class="eyebrow hero-kicker"><span class="status-dot" aria-hidden="true"></span> {profile.title}</p>
        <h1 id="hero-title">Building practical<br /><span class="serif">ML & data systems.</span></h1>
        <div class="hero-description">{profile.introduction.map(paragraph => <p>{paragraph}</p>)}</div>
        <div class="actions"><a class="button button-primary" href="#work">Explore my work <Arrow /></a><a class="text-link" href="#contact">Get in touch <Arrow external /></a>{resumes.filter(r => r.label === 'AI Engineer Résumé').map(r => <a class="text-link" href={r.href} download>{r.label} <Arrow /></a>)}</div>
      </div>
      <aside class="hero-aside" aria-label="Working approach"><span class="eyebrow">The engineering thread</span><div class="thread"><span>01</span><p>Understand the data.</p><span>02</span><p>Build the system.</p><span>03</span><p>Make it useful.</p></div><p class="availability">Based in Egypt<br /><span>Open to Cairo & remote roles<br />and European relocation</span></p></aside>
    </section>

    <section id="experience" class="section" aria-label="Professional experience">
      <SectionHeading number="01" title="Professional experience" note="Client delivery. Data pipelines and analytics." />
      <div class="experience-layout">
        <div class="experience-meta">
          <span class="eyebrow accent">{experience.employment}</span>
          <h3>{experience.title}</h3>
          <p>{experience.period}</p>
          <span class="context-label">{experience.context}</span>
          <p class="small muted">Separate client engagements</p>
        </div>
        <div class="experience-body">
          <p class="lead">{experience.summary}</p>
          <ol class="experience-deliverables">{experience.bullets.map(item => <li>{item}</li>)}</ol>
          <p class="small muted scope-note">Contributions are summarized across separate e-commerce and telecom engagements; this does not imply a shared system or identical stacks.</p>
        </div>
      </div>
    </section>

    <section id="work" class="section work-section" aria-label="Selected work">
      <SectionHeading number="02" title="Selected work" note="Independent projects. Practical questions." />
      <article class="featured-project simplified-project">
        <div class="featured-copy">
          <div class="project-intro"><h3>{meridian.title}<span class="accent">.</span></h3><p class="project-subtitle serif">{meridian.subtitle}</p></div>
          <div class="project-description">
            <p>{meridian.description}</p>
            <div class="contribution"><span class="eyebrow">My contribution</span><p>{meridian.contribution}</p></div>
            <ul class="tags" aria-label="Meridian technologies">{meridian.technologies.map(tool => <li>{tool}</li>)}</ul>
            <div class="actions"><a class="text-link" href={meridian.caseStudy}>More <Arrow /></a><a class="quiet-link" href={meridian.repository}>Repository <Arrow external /></a></div>
          </div>
        </div>
      </article>
      <article class="secondary-project">
        <div class="secondary-index" aria-hidden="true">02 /</div>
        <div>
          <h3>{multiAgent.title}</h3><p>{multiAgent.description}</p>
          <p class="secondary-contribution"><strong>My contribution</strong> — {multiAgent.contribution}</p>
          <ul class="tags" aria-label="Multi-Agent Platform technologies">{multiAgent.technologies.map(tool => <li>{tool}</li>)}</ul>
          <details><summary>Scope & repository evidence <span aria-hidden="true">+</span></summary><div><p>{multiAgent.scope}</p><p>The supplied résumés also describe Bedrock, Titan embeddings, PostgreSQL/pgvector retrieval, RAGAS evaluation on 50 curated query-context pairs, and SQL correction in a LangGraph agent. These résumé-sourced capabilities are not confirmed in the inspected repository revision; project versions still need reconciliation.</p></div></details>
        </div>
        <a class="text-link repository-link" href={multiAgent.repository}>View repository <Arrow external /></a>
      </article>
    </section>

    <section id="expertise" class="section" aria-label="Expertise and certification">
      <SectionHeading number="03" title="An end-to-end perspective" />
      <div class="expertise-grid">{expertise.map(item => <article><span class="eyebrow accent">{item.number} /</span><h3>{item.title}</h3><p>{item.description}</p><ul class="tool-list">{item.tools.map(tool => <li>{tool}</li>)}</ul></article>)}</div>
      <div class="certificates" aria-labelledby="certificates-title">
        <div class="certificates-heading"><h3 id="certificates-title">Certifications & learning</h3><p>AI, data engineering, and cloud operations.</p></div>
        <div class="credential-list">{certifications.map((certificate, index) => <article class:list={['credential', { 'credential-primary': index === 0 }]}>
          <span class="eyebrow accent">{certificate.issuer}</span>
          <h4>{certificate.title}</h4>
          {certificate.issued && <p>Issued {certificate.issued}</p>}
          {certificate.credentialId && <p class="credential-id">Credential ID <span>{certificate.credentialId}</span></p>}
        </article>)}</div>
      </div>
    </section>

    <section id="about" class="section about-layout" aria-label="About Mahmoud"><div><p class="eyebrow accent">04 / About</p><h2>Curious about the model.<br /><span class="serif">Committed to the system.</span></h2></div><div><p class="lead">{profile.about}</p><p>{profile.approach}</p><div class="about-location"><span class="status-dot" aria-hidden="true"></span> Egypt · Cairo · Remote · European relocation</div></div></section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="contact-main"><p class="eyebrow accent">05 / Let’s connect</p><h2 id="contact-title">Useful systems start with<br /><span class="serif">a good conversation.</span></h2><p>I’m exploring AI, ML, and data engineering opportunities. <br />Email me about a role or connect with me on LinkedIn.</p><div class="actions">{contact.email && <a class="button button-primary" href={`mailto:${contact.email}`}>Email Mahmoud <Arrow external /></a>}<a class={contact.email ? "text-link" : "button button-primary"} href={profile.github}>Find me on GitHub <Arrow external /></a>{contact.linkedin && <a class="text-link" href={contact.linkedin}>LinkedIn <Arrow external /></a>}</div>{resumes.length > 0 && <div class="resume-links"><h3>Résumés</h3>{resumes.map(resume => <a class="text-link" href={resume.href} download>{resume.label} <Arrow /></a>)}</div>}</div><aside class="services"><span class="eyebrow muted">Also open to freelance projects</span><h3>Work with me</h3><ul><li>Python backends & API integrations</li><li>Data pipelines, validation & reporting</li><li>AI assistants & retrieval workflows</li></ul><p>Focused engineering support,<br />with a clear delivery and handover.</p></aside></section>
  </div>
</Layout>
