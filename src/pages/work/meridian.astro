---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, meridianStudy as study } from '../../data/portfolio';
const project = projects[0];
---
<Layout title="Meridian — Personal Finance Assistant | Mahmoud Heshmat" description="Meridian: transaction classification, retrieval-grounded budgeting, engineering decisions, and reported evaluation results.">
  <div class="container case-study">
    <a class="back-link" href="/#work"><span aria-hidden="true">←</span> All selected work</a>
    <header class="case-header"><p class="eyebrow accent">Independent project / Engineering case study</p><h1>Meridian<span class="accent">.</span></h1><p class="serif case-subtitle">From transactions to a clearer picture.</p><p class="lead">An AI personal finance assistant connecting transaction classification, spending forecasts, and retrieval-grounded budgeting recommendations.</p><div class="actions"><a class="text-link" href={project.repository}>Explore the repository <Arrow external /></a></div></header>
    <nav class="case-nav" aria-label="Case study contents"><a href="#problem">01 / Context</a><a href="#decisions">02 / Engineering decisions</a><a href="#evaluation">03 / Evaluation</a></nav>
    <section id="problem" class="case-section"><div><p class="eyebrow accent">01 / Context</p><h2>Make spending<br /><span class="serif">understandable.</span></h2></div><div class="prose"><p>{study.problem}</p><h3>Implemented scope</h3><p>{project.scope} Docker Compose supports local development, alongside the AWS delivery workflow.</p><h3>My contribution</h3><p>{study.contribution}</p></div></section>
    <section id="decisions" class="case-section"><div><p class="eyebrow accent">02 / Engineering decisions</p><h2>Choices, context,<br /><span class="serif">and boundaries.</span></h2></div><div class="decision-list">{study.decisions.map((decision, index) => <article><span class="eyebrow accent">0{index + 1}</span><div><h3>{decision.title}</h3><p>{decision.text}</p></div></article>)}</div></section>
    <section id="evaluation" class="evaluation-section"><p class="eyebrow accent">03 / Evaluation</p><h2>Results</h2><p class="evaluation-intro">Owner-reported results from sandbox classification, retrieval evaluation, forecasting, and deployment workflows.</p><div class="evaluation-grid">{study.evaluations.map(result => <article><span class="metric serif">{result.value}</span><h3>{result.label}</h3><p>{result.context}</p></article>)}</div><p class="small muted">Results are supplied by the owner and résumés. They have not been independently reproduced for this portfolio.</p></section>
    <div class="case-end"><a class="text-link" href="/#work">← Back to selected work</a><a class="text-link" href="/#contact">Let’s connect <Arrow /></a></div>
  </div>
</Layout>
